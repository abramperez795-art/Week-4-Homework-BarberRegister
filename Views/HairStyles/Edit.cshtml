@model HairStyle
@{ ViewData["Title"] = "Edit hairstyle"; }
<h1>Edit hairstyle</h1>
<form asp-action="Edit" method="post" class="col-md-7">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="HairLength" class="form-label"></label>
        <input asp-for="HairLength" class="form-control" />
        <span asp-validation-for="HairLength" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TypicalDurationMinutes" class="form-label"></label>
        <input asp-for="TypicalDurationMinutes" class="form-control" />
        <span asp-validation-for="TypicalDurationMinutes" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StartingPrice" class="form-label"></label>
        <input asp-for="StartingPrice" class="form-control" />
        <span asp-validation-for="StartingPrice" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IncludesBeardService" class="form-check-input" />
        <label asp-for="IncludesBeardService" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Save hairstyle</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
