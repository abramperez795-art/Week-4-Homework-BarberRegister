@model IEnumerable<HairStyle>
@{ ViewData["Title"] = "Hair Styles"; }
<h1>Hair Styles</h1>
<p><a asp-action="Create" class="btn btn-primary">Add a hairstyle</a></p>
<div class="row g-3">
@foreach (var item in Model)
{
    <div class="col-md-6 col-lg-4">
        <article class="card h-100">
            <div class="card-body">
                <h2 class="h5">@item.Name</h2>
                <p>@item.Description</p>
                <p>@item.StartingPrice.ToString("C") · @item.TypicalDurationMinutes minutes</p>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                <span>@item.Reviews.Count reviews</span>
            </div>
        </article>
    </div>
}
</div>
