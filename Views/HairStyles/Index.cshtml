@model List<BarberRegister.Models.HairStyle>

@{
    ViewData["Title"] = "Hairstyles";
}

<a asp-action="Create" class="btn btn-primary mb-3">Add a Hair Style</a>

<h1>BarberRegister</h1>

<p>Browse popular barbering styles and their service details.</p>

<table class="table">
    <thead>
        <tr>
            <th>Style</th>
            <th>Description</th>
            <th>Starting Price</th>
            <th></th>
        </tr>
    </thead>
   <tbody>
    @foreach (var hairStyle in Model)
    {
        <tr>
            <td>@hairStyle.Name</td>
            <td>@hairStyle.HairLength</td>
            <td>@hairStyle.StartingPrice.ToString("C")</td>
            <td>
                <a asp-controller="HairStyles"
                   asp-action="Details"
                   asp-route-id="@hairStyle.Id">
                    View details
                </a>
            </td>
        </tr>
    }
</tbody>
</table>

@section Scripts {
    <script src="https://jgrissom.github.io/dotnet-web-dev/week-06/homework-checks.js"></script>
}