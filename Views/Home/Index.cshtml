@{
    ViewData["Title"] = "Barber Register";
}

<section class="py-4">
    <h1>Find inspiration for your next haircut.</h1>
    <p class="lead">
        Barber Register helps clients explore hairstyles and helps
        barbers present their services.
    </p>

    <p>
        Compare starting prices, typical appointment lengths,
        and beard-service options, then read or share a hairstyle review.
    </p>

    <a asp-controller="HairStyles"
       asp-action="Index"
       class="btn btn-primary">
        Browse hairstyles
    </a>
</section>
@section Scripts {
    <script src="https://jgrissom.github.io/dotnet-web-dev/week-11/homework-checks.js"></script>
}